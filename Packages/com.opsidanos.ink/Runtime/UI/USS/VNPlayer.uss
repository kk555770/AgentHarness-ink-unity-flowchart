.vn-root {
  flex-direction: column;
  width: 100%;
  height: 100%;
  padding-left: 24px;
  padding-right: 24px;
  padding-top: 24px;
  padding-bottom: 24px;
}

.vn-dialogue-panel {
  flex-direction: column;
  background-color: rgba(0, 0, 0, 0.70);
  padding-left: 16px;
  padding-right: 16px;
  padding-top: 12px;
  padding-bottom: 12px;
  border-top-left-radius: 10px;
  border-top-right-radius: 10px;
  border-bottom-left-radius: 10px;
  border-bottom-right-radius: 10px;
}

.vn-speaker {
  color: rgb(255, 255, 255);
  font-size: 18px;
  -unity-font-style: bold;
}

.vn-body {
  color: rgb(255, 255, 255);
  font-size: 22px;
  margin-top: 8px;
}

.vn-continue {
  margin-top: 12px;
  align-self: flex-end;
}

.vn-choices {
  flex-direction: column;
  margin-top: 16px;
}

.vn-choice-button {
  margin-top: 8px;
}

.vn-hidden {
  display: none;
}
